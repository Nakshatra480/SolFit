# Helius RPC API key — get one at https://helius.xyz
# Optional. If set, hooks/useSkrStaking.ts uses Helius for higher rate limits.
# If unset, falls back to the public mainnet-beta RPC.
EXPO_PUBLIC_HELIUS_API_KEY=your_key_here

# SolFit sign-in server base URL (functions/src/standalone.ts), no trailing slash
EXPO_PUBLIC_AUTH_URL=https://your-auth-host.example
